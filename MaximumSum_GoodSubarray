//time complaxity = O(n), space = O(k)
#include <bits/stdc++.h>
#include<vector>
using namespace std;
int sum_of_kdistinct(vector<int>&A, int k){
    unordered_map<int,int>freq;
    int l = 0;
    long long sum = 0;
    long long maxsum = 0;
    for(int r = 0; r<A.size(); r++){
        freq[A[r]] ++;
        sum += A[r];
        while(freq.size() > k){
            freq[A[l]] --;
            sum -= A[l];
            if(freq[A[l]] == 0){
                freq.erase(A[l]);
            }
        }
        maxsum = max(sum, maxsum);
    }
    return maxsum;
    
}

int main() {
    int n, k;
    cin>>n;
    cin>>k;
    vector<int>A(n);
    for(int i =0; i<n; i++){
        cin>>A[i];
    }
    cout<<sum_of_kdistinct(A,k);
}
